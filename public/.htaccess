# ─────────────────────────────────────────────────────────────────────────────
# Force PHP handler (HostGator / EasyApache 4)
# N.B.: Do punojë VETËM nëse ai version ekziston në server.
# Provo php74. Nëse s’punon, komentoje dhe ç’komento php82 më poshtë.
# ─────────────────────────────────────────────────────────────────────────────
<IfModule mime_module>
    AddHandler application/x-httpd-ea-php74___lsphp .php .php7 .phtml
    # AddHandler application/x-httpd-ea-php82 .php .phtml   # fallback nëse s’ka php74
</IfModule>

# ─────────────────────────────────────────────────────────────────────────────
# Laravel public/.htaccess i optimizuar
# ─────────────────────────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Mos bëj content negotiation të çuditshme
    <IfModule mod_negotiation.c>
        Options -MultiViews
    </IfModule>

    # Heq slash-in fundor vetëm kur NUK është direktori (shmang loop-et)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+?)/$ /$1 [L,R=301]

    # Shërbe skedarët ekzistues normalisht
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Front controller
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]

    # Ruaj Authorization header për Laravel
    RewriteCond %{HTTP:Authorization} .
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

# ─────────────────────────────────────────────────────────────────────────────
# Siguri: blloko skedarët sensitivë në public
# ─────────────────────────────────────────────────────────────────────────────
# Mos lejo qasje direkte te këta emra nëse dikush i kopjon gabimisht në /public
<FilesMatch "^(artisan|server\.php|composer\.(json|lock)|package(-lock)?\.json|yarn\.lock|phpunit\.xml(\.dist)?|\.env(\..*)?)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# Fshi listimin e direktorisë
Options -Indexes

# Kompresim i lehtë (nëse mod_deflate është aktiv)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/json application/javascript application/xml
</IfModule>

# Cache bazik për asset-et
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"
    ExpiresDefault "access plus 1 hour"
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “alt-php74” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-alt-php74___lsphp .php .php7 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
